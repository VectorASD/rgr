<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LogicSimulator.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
		Width="1400" Height="800"
        x:Class="LogicSimulator.Views.MainWindow"
        Icon="/Assets/vectorasd-logo.ico"
        Title="LogicSimulator">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Window.Styles>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
		</Style>
		<Style Selector="Border.b">
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="#0d8"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="Padding" Value="6"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Margin" Value="-5"/>
			<Setter Property="Padding" Value="4"/>
			<Setter Property="MinHeight" Value="0"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Файл">
				<MenuItem Header="Создать" Command="{Binding Comm}" CommandParameter="Create"/>
				<MenuItem Header="Открыть" Command="{Binding Comm}" CommandParameter="Open"/>
				<MenuItem Header="Сохранить" Command="{Binding Comm}" CommandParameter="Save"/>
				<MenuItem Header="Выйти" Command="{Binding Comm}" CommandParameter="Exit"/>
			</MenuItem>
		</Menu>
		<Grid ColumnDefinitions="*,3*,*">
			<ListBox Items="{Binding ItemTypes}" SelectedIndex="{Binding SelectedItem}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<ContentControl Content="{Binding}"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Panel Grid.Column="1">
				<TextBlock Text="{Binding Logg}" Background="AliceBlue"/>
				<Canvas Tag="Scene" Name="Canvas" Background="#0000"/>
			</Panel>
			<Grid Grid.Column="2" RowDefinitions="auto,*" DoubleTapped="DTapped">
				<Border Classes="b" BorderBrush="#4df">
					<TextBlock>Название проекта</TextBlock>
				</Border>
				<ListBox Grid.Row="1" Padding="10 4 0 0">
					<Border Classes="b">
						<TextBlock>Название схемы</TextBlock>
					</Border>
					<Border Classes="b">
						<TextBlock>Название схемы</TextBlock>
					</Border>
					<Border Classes="b">
						<TextBlock>Название схемы</TextBlock>
					</Border>
				</ListBox>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
